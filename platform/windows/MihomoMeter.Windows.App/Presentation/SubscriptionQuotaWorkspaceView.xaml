<UserControl
    x:Class="MihomoMeter.Windows.App.Presentation.SubscriptionQuotaWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:MihomoMeter.Windows.App.Presentation">

    <Grid x:Name="Root">
        <ScrollViewer>
            <StackPanel Padding="32" Spacing="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="订阅余额" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="独立追踪机场累计配额；不会与本机 Proxy 流量对账。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10">
                        <HyperlinkButton
                            Content="配置指引"
                            NavigateUri="https://github.com/HongXunPan/mihomo-meter/wiki/%E9%85%8D%E7%BD%AE%E8%AE%A2%E9%98%85%E5%9C%B0%E5%9D%80" />
                        <Button Click="ManageProfilesButton_Click" Content="管理 Profile" />
                        <Button Click="RefreshAllButton_Click" Content="立即查询全部" IsEnabled="{x:Bind ViewModel.CanRefreshAll, Mode=OneWay}" />
                        <Button AutomationProperties.Name="更多订阅余额操作">
                            <Button.Content>
                                <SymbolIcon Symbol="More" />
                            </Button.Content>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="ClearButton_Click"
                                        IsEnabled="{x:Bind ViewModel.CanClear, Mode=OneWay}"
                                        Text="清空配额数据" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=OneWay}"
                    Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                    Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" />

                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
                    <ProgressRing IsActive="True" />
                    <TextBlock Text="正在准备订阅配额账本…" />
                </StackPanel>

                <StackPanel
                    Spacing="20"
                    Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="配额与累计趋势" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="图表只连接同一连续周期内的真实快照，不插值或补零。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Width="140"
                            DisplayMemberPath="Title"
                            ItemsSource="{x:Bind ViewModel.WindowOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedWindow, Mode=TwoWay}" />
                    </Grid>

                    <ItemsRepeater
                        ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.CardsVisibility, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinColumnSpacing="14"
                                MinItemWidth="400"
                                MinRowSpacing="14" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="presentation:SubscriptionQuotaCardViewModel">
                                <Border
                                    Margin="0"
                                    Padding="20"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind IdentityText, Mode=OneWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Button
                                                    Click="ShowTrendButton_Click"
                                                    Content="查看趋势"
                                                    Tag="{x:Bind}" />
                                                <Button
                                                    Click="RefreshProfileButton_Click"
                                                    Content="立即查询"
                                                    IsEnabled="{x:Bind CanRefresh, Mode=OneWay}"
                                                    Tag="{x:Bind Id}"
                                                    Visibility="{x:Bind RefreshVisibility, Mode=OneWay}" />
                                                <Button
                                                    Click="ConfirmCycleButton_Click"
                                                    Content="确认新周期"
                                                    Tag="{x:Bind CycleId}"
                                                    Visibility="{x:Bind ConfirmVisibility, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="剩余" />
                                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{x:Bind RemainingText, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind PercentageText, Mode=OneWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="累计" />
                                                <TextBlock Text="{x:Bind UsedText, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind TotalText, Mode=OneWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="状态" />
                                                <TextBlock Text="{x:Bind UpdatedText, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind ForecastText, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind ExpirationText, Mode=OneWay}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>

                                        <ProgressBar Maximum="1" Value="{x:Bind RemainingRatio, Mode=OneWay}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind StatusText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <Border
                                            Padding="10"
                                            Background="{ThemeResource MihomoStatusWarningBackgroundBrush}"
                                            CornerRadius="8"
                                            Visibility="{x:Bind ConfirmVisibility, Mode=OneWay}">
                                            <TextBlock
                                                Foreground="{ThemeResource MihomoStatusWarningBrush}"
                                                Text="用量下降可能代表套餐重置，请确认新周期后再参与耗尽预测。"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <ItemsRepeater
                                            ItemsSource="{x:Bind RecentEvents, Mode=OneWay}"
                                            Visibility="{x:Bind RecentEventsVisibility, Mode=OneWay}">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="presentation:QuotaEventSummaryViewModel">
                                                    <Grid Padding="10,4" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Symbol}" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind TimingText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                        <presentation:QuotaTrendChartView Model="{x:Bind ChartModel, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <StackPanel
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                        <SymbolIcon Symbol="Globe" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="尚未追踪订阅" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="可启用唯一运行候选，或选择 Profile 目录后开启精确追踪。"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
