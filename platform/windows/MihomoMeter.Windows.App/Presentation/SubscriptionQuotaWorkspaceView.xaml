<UserControl
    x:Class="MihomoMeter.Windows.App.Presentation.SubscriptionQuotaWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:MihomoMeter.Windows.App.Presentation">

    <Grid x:Name="Root">
        <ScrollViewer>
            <StackPanel Padding="32" Spacing="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="订阅余额" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="独立追踪机场累计配额；不会与本机 Proxy 流量对账。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button Click="SelectDirectoryButton_Click" Content="选择 Profile 目录" />
                        <Button Click="RefreshAllButton_Click" Content="立即查询全部" IsEnabled="{x:Bind ViewModel.CanRefreshAll, Mode=OneWay}" />
                        <Button Click="ClearButton_Click" Content="清空配额数据" IsEnabled="{x:Bind ViewModel.CanClear, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=OneWay}"
                    Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                    Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" />

                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
                    <ProgressRing IsActive="True" />
                    <TextBlock Text="正在准备订阅配额账本…" />
                </StackPanel>

                <StackPanel
                    Spacing="20"
                    Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
                    <Border
                        Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="当前运行订阅（轻量模式）" />
                                <TextBlock Text="{x:Bind ViewModel.RuntimeStatusText, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="每 5 分钟只读观察 Mihomo Provider；只有唯一候选时才允许启用。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button
                                    Click="EnableRuntimeButton_Click"
                                    Content="确认并启用"
                                    IsEnabled="{x:Bind ViewModel.CanEnableRuntime, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    Click="PauseRuntimeButton_Click"
                                    Content="暂停"
                                    IsEnabled="{x:Bind ViewModel.CanPauseRuntime, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="指定 Profile" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.DirectoryStatusText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Click="StopDirectoryAccessButton_Click"
                                    Content="停止目录访问" />
                            </Grid>

                            <ListView
                                IsItemClickEnabled="False"
                                ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="presentation:ProfileTrackingOptionViewModel">
                                        <Grid Padding="4,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Detail, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox
                                                Grid.Column="1"
                                                DisplayMemberPath="Title"
                                                IsEnabled="{x:Bind IsTracked, Mode=OneWay}"
                                                ItemsSource="{x:Bind IntervalOptions}"
                                                SelectedItem="{x:Bind SelectedInterval, Mode=TwoWay}"
                                                SelectionChanged="RefreshInterval_SelectionChanged"
                                                Tag="{x:Bind}" />
                                            <ToggleSwitch
                                                Grid.Column="2"
                                                IsEnabled="{x:Bind IsSupported, Mode=OneWay}"
                                                IsOn="{x:Bind IsTracked, Mode=OneWay}"
                                                OffContent="未追踪"
                                                OnContent="追踪中"
                                                Tag="{x:Bind}"
                                                Toggled="ProfileTracking_Toggled" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="配额与累计趋势" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="图表只连接同一连续周期内的真实快照，不插值或补零。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Width="140"
                            DisplayMemberPath="Title"
                            ItemsSource="{x:Bind ViewModel.WindowOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedWindow, Mode=TwoWay}" />
                    </Grid>

                    <ItemsRepeater
                        ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.CardsVisibility, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinColumnSpacing="14"
                                MinItemWidth="400"
                                MinRowSpacing="14" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="presentation:SubscriptionQuotaCardViewModel">
                                <Border
                                    Margin="0"
                                    Padding="20"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind IdentityText, Mode=OneWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Button
                                                    Click="RefreshProfileButton_Click"
                                                    Content="立即查询"
                                                    IsEnabled="{x:Bind CanRefresh, Mode=OneWay}"
                                                    Tag="{x:Bind Id}"
                                                    Visibility="{x:Bind RefreshVisibility, Mode=OneWay}" />
                                                <Button
                                                    Click="ConfirmCycleButton_Click"
                                                    Content="确认新周期"
                                                    Tag="{x:Bind CycleId}"
                                                    Visibility="{x:Bind ConfirmVisibility, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="剩余" />
                                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{x:Bind RemainingText, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind PercentageText, Mode=OneWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="累计" />
                                                <TextBlock Text="{x:Bind UsedText, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind TotalText, Mode=OneWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="状态" />
                                                <TextBlock Text="{x:Bind UpdatedText, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind ForecastText, Mode=OneWay}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>

                                        <ProgressBar Maximum="1" Value="{x:Bind RemainingRatio, Mode=OneWay}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind StatusText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <presentation:QuotaTrendChartView Model="{x:Bind ChartModel, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <StackPanel
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                        <SymbolIcon Symbol="Globe" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="尚未追踪订阅" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="可启用唯一运行候选，或选择 Profile 目录后开启精确追踪。"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
