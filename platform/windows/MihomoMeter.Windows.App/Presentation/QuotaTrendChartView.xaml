<UserControl
    x:Class="MihomoMeter.Windows.App.Presentation.QuotaTrendChartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="8">
        <Grid RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="RangeUsageText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="PointDetailText"
                Grid.Row="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Stretch"
                MaxLines="3"
                TextAlignment="Right"
                TextTrimming="CharacterEllipsis"
                VerticalAlignment="Center"
                TextWrapping="Wrap" />
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="8" Height="8" Fill="{ThemeResource MihomoTrafficDownloadBrush}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="下载增量" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="8" Height="8" Fill="{ThemeResource MihomoTrafficUploadBrush}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="上传增量" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Rectangle
                    Width="12"
                    Height="2"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="总消耗" />
            </StackPanel>
        </StackPanel>

        <Grid Height="220">
            <Canvas
                x:Name="ChartCanvas"
                AutomationProperties.HelpText="使用左右方向键选择真实快照，Home 和 End 跳到首尾。"
                AutomationProperties.Name="订阅累计趋势图"
                Background="Transparent"
                IsTabStop="True"
                KeyDown="ChartCanvas_KeyDown"
                PointerExited="ChartCanvas_PointerExited"
                PointerMoved="ChartCanvas_PointerMoved"
                SizeChanged="ChartCanvas_SizeChanged" />
            <TextBlock
                x:Name="EmptyText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Grid>
    </StackPanel>
</UserControl>
