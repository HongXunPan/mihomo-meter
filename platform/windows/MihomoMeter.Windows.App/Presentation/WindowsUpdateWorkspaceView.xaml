<UserControl
    x:Class="MihomoMeter.Windows.App.Presentation.WindowsUpdateWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel
            MaxWidth="720"
            Padding="32"
            HorizontalAlignment="Left"
            Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock
                    FontSize="32"
                    FontWeight="SemiBold"
                    Text="关于与更新" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="手动检查 Windows 实际稳定版本，并由你决定是否打开下载页面。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="14">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Mihomo Meter" />
                    <TextBlock Text="{x:Bind ViewModel.CurrentVersionText, Mode=OneWay}" />
                    <Button
                        HorizontalAlignment="Left"
                        Click="CheckButton_Click"
                        Content="{x:Bind ViewModel.CheckButtonText, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanCheck, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        Click="OpenReleaseButton_Click"
                        Content="打开发布页面"
                        Visibility="{x:Bind ViewModel.OpenReleaseVisibility, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="检查更新只读取 GitHub 上的公开 Windows 版本描述，不会上传 Controller 配置、Secret、流量或其他本地数据，也不会自动下载、安装或重启应用。"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
