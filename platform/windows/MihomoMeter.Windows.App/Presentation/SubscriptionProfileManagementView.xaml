<UserControl
    x:Class="MihomoMeter.Windows.App.Presentation.SubscriptionProfileManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:MihomoMeter.Windows.App.Presentation">

    <ScrollViewer MaxHeight="540">
        <StackPanel Spacing="16">
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock FontWeight="SemiBold" Text="当前运行订阅（轻量模式）" />
                        <TextBlock Text="{x:Bind ViewModel.RuntimeStatusText, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="每 5 分钟只读观察 Mihomo Provider；只有唯一候选时才允许启用。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button
                            Click="EnableRuntimeButton_Click"
                            Content="确认并启用"
                            IsEnabled="{x:Bind ViewModel.CanEnableRuntime, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            Click="PauseRuntimeButton_Click"
                            Content="暂停"
                            IsEnabled="{x:Bind ViewModel.CanPauseRuntime, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="指定 Profile" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.DirectoryStatusText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Click="SelectDirectoryButton_Click" Content="选择目录" />
                            <Button Click="StopDirectoryAccessButton_Click" Content="停止目录访问" />
                        </StackPanel>
                    </Grid>

                    <ListView
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="presentation:ProfileTrackingOptionViewModel">
                                <Grid Padding="4,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Detail, Mode=OneWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="1"
                                        DisplayMemberPath="Title"
                                        IsEnabled="{x:Bind IsTracked, Mode=OneWay}"
                                        ItemsSource="{x:Bind IntervalOptions}"
                                        SelectedItem="{x:Bind SelectedInterval, Mode=TwoWay}"
                                        SelectionChanged="RefreshInterval_SelectionChanged"
                                        Tag="{x:Bind}" />
                                    <ToggleSwitch
                                        Grid.Column="2"
                                        IsEnabled="{x:Bind IsSupported, Mode=OneWay}"
                                        IsOn="{x:Bind IsTracked, Mode=OneWay}"
                                        OffContent="未追踪"
                                        OnContent="追踪中"
                                        Tag="{x:Bind}"
                                        Toggled="ProfileTracking_Toggled" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
