<UserControl
    x:Class="MihomoMeter.Windows.App.Presentation.RealtimeMonitoringView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid
            Padding="32"
            RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Text="实时监控" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="连接 Mihomo Controller，查看实时分类速率。" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Spacing="4">
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.StateTitle, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.VersionText, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <InfoBar
                Grid.Row="1"
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                Severity="Informational"
                Title="{x:Bind ViewModel.StateTitle, Mode=OneWay}" />

            <StackPanel
                Grid.Row="2"
                Spacing="20">
                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="14">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Controller 连接" />
                        <TextBox
                            Header="Controller 地址"
                            PlaceholderText="127.0.0.1:9090"
                            Text="{x:Bind ViewModel.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <PasswordBox
                            x:Name="SecretPasswordBox"
                            Header="访问密钥（未配置鉴权时可留空）"
                            PlaceholderText="留空时复用同地址已保存的密钥"
                            PasswordRevealMode="Peek" />
                        <CheckBox
                            x:Name="ForceEmptySecretCheckBox"
                            Content="本次明确不使用 Secret；验证成功后删除已保存凭据" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="仅允许 127.0.0.1 或 ::1。验证成功后，Secret 只保存到 Windows Credential Manager。"
                            TextWrapping="Wrap" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="10">
                            <Button
                                Click="ConnectButton_Click"
                                Content="{x:Bind ViewModel.ConnectButtonText, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanConnect, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                Click="DisconnectButton_Click"
                                Content="断开"
                                IsEnabled="{x:Bind ViewModel.CanDisconnect, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid RowSpacing="12" ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="Proxy" />
                            <TextBlock FontSize="18" Text="{x:Bind ViewModel.ProxyRateText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="DIRECT" />
                            <TextBlock FontSize="18" Text="{x:Bind ViewModel.DirectRateText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="REJECT" />
                            <TextBlock FontSize="18" Text="{x:Bind ViewModel.RejectRateText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="未知" />
                            <TextBlock FontSize="18" Text="{x:Bind ViewModel.UnknownRateText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.CoverageText, Mode=OneWay}" />

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="连接分析覆盖率" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="统计本次会话中 Proxy 连接的主机名与应用识别覆盖率；明细请在 Proxy 流量的“实时连接”页查看。"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Message="实时页仅展示脱敏主机名与应用名称；完整进程路径、连接 ID、目标 IP、节点和规则不会显示或持久化。"
                            Severity="Informational"
                            Title="隐私边界" />

                        <Grid RowSpacing="12" ColumnSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Padding="14"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <StackPanel Spacing="5">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Proxy 连接样本" />
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.ProxyConnectionSampleText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Padding="14"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <StackPanel Spacing="5">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="主机名可识别" />
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.HostnameIdentifiedText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Row="1"
                                Padding="14"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <StackPanel Spacing="5">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="应用可识别" />
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.ApplicationIdentifiedText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Padding="14"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <StackPanel Spacing="5">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="两者同时可识别" />
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.FullyIdentifiedText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="请制造受控 Proxy 流量；重连、数据超时、停止监控或内核计数重置会清空本次样本。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
