<UserControl
    x:Class="MihomoMeter.Windows.App.Presentation.LiveConnectionWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:MihomoMeter.Windows.App.Presentation">

    <ScrollViewer>
        <StackPanel
            Padding="32"
            Spacing="18">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.ContextTitle, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.ContextDetail, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.StateText, Mode=OneWay}" />
                </StackPanel>

                <ComboBox
                    Grid.Column="1"
                    Width="130"
                    DisplayMemberPath="Title"
                    Header="流量路径"
                    ItemsSource="{x:Bind ViewModel.RouteOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedRoute, Mode=TwoWay}" />
            </Grid>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsDiagnosticOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.DiagnosticDetail, Mode=OneWay}"
                Severity="{x:Bind ViewModel.DiagnosticSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.DiagnosticTitle, Mode=OneWay}" />

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="仅在内存中保留脱敏主机名、应用名称、开始时间、累计和速率；不显示或持久化连接 ID、完整进程路径、目标 IP、端口、节点、规则和链路。"
                Severity="Informational"
                Title="隐私边界" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    Width="140"
                    DisplayMemberPath="Title"
                    Header="查看方式"
                    ItemsSource="{x:Bind ViewModel.ModeOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedMode, Mode=TwoWay}" />

                <TextBox
                    Grid.Column="1"
                    Header="筛选"
                    PlaceholderText="搜索应用或域名"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid
                Padding="14,0"
                ColumnSpacing="14"
                Visibility="{x:Bind ViewModel.ConnectionListVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" Text="域名" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="应用" />
                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="实时速率" />
                <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="累计" />
                <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="时长" />
            </Grid>

            <ListView
                IsItemClickEnabled="False"
                ItemsSource="{x:Bind ViewModel.Connections, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.ConnectionListVisibility, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="presentation:LiveConnectionRowViewModel">
                        <Border
                            Margin="0,0,0,6"
                            Padding="14"
                            AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Hostname, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ApplicationName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind RateText, Mode=OneWay}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind CumulativeText, Mode=OneWay}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind DurationText, Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid
                Padding="14,0"
                ColumnSpacing="14"
                Visibility="{x:Bind ViewModel.GroupListVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.PrimaryColumnTitle, Mode=OneWay}" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind ViewModel.RelationColumnTitle, Mode=OneWay}" />
                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="实时速率" />
                <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="累计" />
            </Grid>

            <ListView
                IsItemClickEnabled="False"
                ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.GroupListVisibility, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="presentation:LiveConnectionGroupRowViewModel">
                        <Border
                            Margin="0,0,0,6"
                            Padding="14"
                            AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind RelationText, Mode=OneWay}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind RateText, Mode=OneWay}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind CumulativeText, Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                HorizontalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                <SymbolIcon Symbol="Find" />
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="暂无活动连接" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.EmptyStateText, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
