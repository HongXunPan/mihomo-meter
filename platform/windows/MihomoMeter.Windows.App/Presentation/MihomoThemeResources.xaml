<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="MihomoBrandPrimaryBrush" Color="#56CFC5" />
            <SolidColorBrush x:Key="MihomoOnAccentBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="MihomoStatusSuccessBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="MihomoStatusWarningBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="MihomoStatusWarningBackgroundBrush" Color="#24F59E0B" />
            <SolidColorBrush x:Key="MihomoStatusDangerBrush" Color="#FB7185" />
            <SolidColorBrush x:Key="MihomoStatusDangerBackgroundBrush" Color="#24FB7185" />
            <SolidColorBrush x:Key="MihomoStatusNeutralBrush" Color="#FF9CA3AF" />
            <SolidColorBrush x:Key="MihomoTrafficProxyBrush" Color="#B5A4D6" />
            <SolidColorBrush x:Key="MihomoTrafficDirectBrush" Color="#9CA3AF" />
            <SolidColorBrush x:Key="MihomoTrafficUnknownBrush" Color="#EAB308" />
            <SolidColorBrush x:Key="MihomoTrafficDownloadBrush" Color="#72A7FF" />
            <SolidColorBrush x:Key="MihomoTrafficUploadBrush" Color="#FB923C" />
            <SolidColorBrush x:Key="MihomoTrafficDownloadAreaBrush" Color="#3D72A7FF" />
            <SolidColorBrush x:Key="MihomoTrafficUploadAreaBrush" Color="#3DFB923C" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MihomoBrandPrimaryBrush" Color="#007A73" />
            <SolidColorBrush x:Key="MihomoOnAccentBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="MihomoStatusSuccessBrush" Color="#15803D" />
            <SolidColorBrush x:Key="MihomoStatusWarningBrush" Color="#B45309" />
            <SolidColorBrush x:Key="MihomoStatusWarningBackgroundBrush" Color="#14B45309" />
            <SolidColorBrush x:Key="MihomoStatusDangerBrush" Color="#B91C1C" />
            <SolidColorBrush x:Key="MihomoStatusDangerBackgroundBrush" Color="#14B91C1C" />
            <SolidColorBrush x:Key="MihomoStatusNeutralBrush" Color="#FF626A77" />
            <SolidColorBrush x:Key="MihomoTrafficProxyBrush" Color="#66528F" />
            <SolidColorBrush x:Key="MihomoTrafficDirectBrush" Color="#626A77" />
            <SolidColorBrush x:Key="MihomoTrafficUnknownBrush" Color="#A16207" />
            <SolidColorBrush x:Key="MihomoTrafficDownloadBrush" Color="#0B5CAD" />
            <SolidColorBrush x:Key="MihomoTrafficUploadBrush" Color="#C2410C" />
            <SolidColorBrush x:Key="MihomoTrafficDownloadAreaBrush" Color="#470B5CAD" />
            <SolidColorBrush x:Key="MihomoTrafficUploadAreaBrush" Color="#47C2410C" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="MihomoBrandPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="MihomoOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="MihomoStatusSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MihomoStatusWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MihomoStatusWarningBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MihomoStatusDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MihomoStatusDangerBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MihomoStatusNeutralBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MihomoTrafficProxyBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MihomoTrafficDirectBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MihomoTrafficUnknownBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MihomoTrafficDownloadBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MihomoTrafficUploadBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MihomoTrafficDownloadAreaBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MihomoTrafficUploadAreaBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
