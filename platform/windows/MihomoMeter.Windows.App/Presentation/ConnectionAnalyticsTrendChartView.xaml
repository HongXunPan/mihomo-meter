<UserControl
    x:Class="MihomoMeter.Windows.App.Presentation.ConnectionAnalyticsTrendChartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="8">
        <Grid Height="48">
            <TextBlock
                x:Name="PointDetailText"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Right"
                TextWrapping="Wrap" />
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="8" Height="8" Fill="{ThemeResource MihomoTrafficDownloadBrush}" />
                <TextBlock Text="下载" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="8" Height="8" Fill="{ThemeResource MihomoTrafficUploadBrush}" />
                <TextBlock Text="上传" />
            </StackPanel>
        </StackPanel>

        <Grid Height="260">
            <Canvas
                x:Name="ChartCanvas"
                AutomationProperties.HelpText="使用左右方向键选择日期，Home 和 End 跳到首尾。"
                AutomationProperties.Name="最近三十天连接分析趋势图"
                Background="Transparent"
                IsTabStop="True"
                KeyDown="ChartCanvas_KeyDown"
                PointerExited="ChartCanvas_PointerExited"
                PointerMoved="ChartCanvas_PointerMoved"
                SizeChanged="ChartCanvas_SizeChanged" />
            <TextBlock
                x:Name="EmptyText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="最近 30 天暂无匹配的归因流量。" />
        </Grid>
    </StackPanel>
</UserControl>
