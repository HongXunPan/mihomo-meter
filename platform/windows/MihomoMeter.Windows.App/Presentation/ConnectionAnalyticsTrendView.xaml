<UserControl
    x:Class="MihomoMeter.Windows.App.Presentation.ConnectionAnalyticsTrendView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="28" Spacing="18">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock
                            FontSize="26"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.FilterDescription, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="最近 30 个本地自然日，包含今日；零流量日期会补齐。" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Click="RefreshButton_Click"
                        Content="刷新"
                        IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                        VerticalAlignment="Top" />
                </Grid>

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsMessageOpen, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                    Severity="Warning"
                    Title="趋势加载失败" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="30 天合计" />
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="活跃日均" />
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="{x:Bind ViewModel.AverageText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="2"
                        Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="峰值日" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind ViewModel.PeakText, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="3"
                        Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="有流量天数" />
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="{x:Bind ViewModel.ActiveDayText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
                    <ProgressRing IsActive="True" />
                    <TextBlock Text="正在刷新归因趋势…" />
                </StackPanel>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <ContentControl
                        x:Name="ChartHost"
                        HorizontalContentAlignment="Stretch" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
