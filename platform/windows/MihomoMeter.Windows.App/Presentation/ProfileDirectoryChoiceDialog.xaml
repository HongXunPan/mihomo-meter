<ContentDialog
    x:Class="MihomoMeter.Windows.App.Presentation.ProfileDirectoryChoiceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="BrowseOtherButton_Click"
    PrimaryButtonText="浏览其他目录"
    Title="选择 Profile 目录">

    <StackPanel MinWidth="520" Spacing="12">
        <TextBlock
            Text="请选择根部直接包含 profiles.yaml 的目录。客户端入口只负责预设选择器位置，不会自动扫描目录。"
            TextWrapping="Wrap" />

        <Border
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="Clash Verge Rev" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="%APPDATA%\io.github.clash-verge-rev.clash-verge-rev"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="打开 Clash Verge Rev Profile 目录"
                    Click="SuggestedDirectoryButton_Click"
                    Content="打开目录"
                    Tag="%APPDATA%\io.github.clash-verge-rev.clash-verge-rev" />
            </Grid>
        </Border>

        <Border
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="Clash Verge（旧版）" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="%APPDATA%\top.gydi.clashverge"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="打开 Clash Verge 旧版 Profile 目录"
                    Click="SuggestedDirectoryButton_Click"
                    Content="打开目录"
                    Tag="%APPDATA%\top.gydi.clashverge" />
            </Grid>
        </Border>

        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="便携版、自定义目录或其他兼容客户端，请使用下方“浏览其他目录”；不要选择 profiles 子目录。"
            TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
