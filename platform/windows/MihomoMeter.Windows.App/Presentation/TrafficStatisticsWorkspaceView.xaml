<UserControl
    x:Class="MihomoMeter.Windows.App.Presentation.TrafficStatisticsWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:MihomoMeter.Windows.App.Presentation">

    <Grid x:Name="Root">
        <ScrollViewer>
            <StackPanel
                Padding="32"
                Spacing="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="6">
                        <TextBlock
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="Proxy 流量" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="管理秒表式统计任务，并查看本机 Proxy 累计。" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.StatisticsStatusText, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            Click="StartIntervalButton_Click"
                            Content="开始统计"
                            IsEnabled="{x:Bind ViewModel.CanStartInterval, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button AutomationProperties.Name="更多统计操作">
                            <Button.Content>
                                <SymbolIcon Symbol="More" />
                            </Button.Content>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="ClearButton_Click"
                                        IsEnabled="{x:Bind ViewModel.CanClear, Mode=OneWay}"
                                        Text="清空本地统计" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=OneWay}"
                    Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                    Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" />

                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
                    <ProgressRing IsActive="True" />
                    <TextBlock Text="正在准备本地统计…" />
                </StackPanel>

                <StackPanel
                    Spacing="20"
                    Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.MonitoringStatusText, Mode=OneWay}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="今日 Proxy" />
                                <TextBlock Text="{x:Bind ViewModel.TodayDownloadText, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.TodayUploadText, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.TodayTotalText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="历史 Proxy" />
                                <TextBlock Text="{x:Bind ViewModel.LifetimeDownloadText, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.LifetimeUploadText, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.LifetimeTotalText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="2"
                            Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="统计任务" />
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.ActiveCountText, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="任务共享权威 Proxy 累计基线。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ContentControl
                        x:Name="DailyChartHost"
                        HorizontalContentAlignment="Stretch" />

                    <Border
                        x:Name="IntervalEditor"
                        Padding="12"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="IntervalEditorTitle" FontWeight="SemiBold" />
                                <TextBox
                                    x:Name="IntervalNameBox"
                                    AutomationProperties.Name="统计任务名称"
                                    PlaceholderText="输入任务名称" />
                                <TextBlock
                                    x:Name="IntervalEditorValidation"
                                    Foreground="{ThemeResource MihomoStatusDangerBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Click="SaveIntervalEditorButton_Click"
                                Content="保存"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Bottom"
                                Click="CancelIntervalEditorButton_Click"
                                Content="取消" />
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="统计任务" />
                        <RadioButtons
                            x:Name="IntervalFilterButtons"
                            Grid.Column="1"
                            MaxColumns="3"
                            SelectionChanged="IntervalFilterButtons_SelectionChanged">
                            <x:String>全部</x:String>
                            <x:String>进行中</x:String>
                            <x:String>历史</x:String>
                        </RadioButtons>
                    </Grid>

                    <Grid Padding="14,0" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="任务" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="状态" />
                        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="下载" />
                        <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="上传" />
                        <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="合计" />
                        <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="操作" />
                    </Grid>

                    <ListView
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind ViewModel.Intervals, Mode=OneWay}"
                        SelectionMode="None"
                        Visibility="{x:Bind ViewModel.IntervalListVisibility, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="presentation:TrafficIntervalRowViewModel">
                                <Border
                                    Padding="14,11"
                                    AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Name, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind TimeText, Mode=OneWay}" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind StatusText, Mode=OneWay}" />
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" Foreground="{ThemeResource MihomoTrafficDownloadBrush}" Text="{x:Bind DownloadText, Mode=OneWay}" />
                                        <TextBlock Grid.Column="3" HorizontalAlignment="Right" Foreground="{ThemeResource MihomoTrafficUploadBrush}" Text="{x:Bind UploadText, Mode=OneWay}" />
                                        <TextBlock Grid.Column="4" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{x:Bind TotalText, Mode=OneWay}" />
                                        <Button
                                            Grid.Column="5"
                                            AutomationProperties.Name="任务操作"
                                            IsEnabled="{x:Bind CanOperate, Mode=OneWay}">
                                            <Button.Content>
                                                <SymbolIcon Symbol="More" />
                                            </Button.Content>
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem
                                                        Click="StopIntervalButton_Click"
                                                        Tag="{x:Bind Id}"
                                                        Text="停止"
                                                        Visibility="{x:Bind StopVisibility, Mode=OneWay}" />
                                                    <MenuFlyoutItem Click="RenameIntervalButton_Click" Tag="{x:Bind Id}" Text="重命名" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Click="DeleteIntervalButton_Click" Tag="{x:Bind Id}" Text="删除" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                        <SymbolIcon Symbol="Clock" />
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="没有统计任务" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.EmptyStateMessage, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
