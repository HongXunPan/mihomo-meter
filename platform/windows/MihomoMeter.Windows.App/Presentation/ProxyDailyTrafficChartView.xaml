<UserControl
    x:Class="MihomoMeter.Windows.App.Presentation.ProxyDailyTrafficChartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:MihomoMeter.Windows.App.Presentation">

    <Border
        Padding="18"
        AutomationProperties.Name="最近三十天 Proxy 每日上传下载堆叠柱图"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="最近 30 天" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.RangeDateText, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Spacing="4">
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.RangeTotalText, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.PeakDayText, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <StackPanel
                Orientation="Horizontal"
                Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="下载" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock Text="上传" />
                </StackPanel>
            </StackPanel>

            <Grid
                HorizontalAlignment="Center"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid
                    Width="64"
                    Height="120">
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.ChartAxisMaximumText, Mode=OneWay}" />
                    <TextBlock
                        Margin="0,25,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.ChartAxisThreeQuarterText, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.ChartAxisHalfText, Mode=OneWay}" />
                    <TextBlock
                        Margin="0,0,0,25"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.ChartAxisQuarterText, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="0 B" />
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    Spacing="4">
                    <Grid
                        Width="510"
                        Height="120">
                        <Border
                            VerticalAlignment="Top"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Border
                            Margin="0,30,0,0"
                            VerticalAlignment="Top"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Border
                            VerticalAlignment="Center"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Border
                            Margin="0,0,0,30"
                            VerticalAlignment="Bottom"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Border
                            VerticalAlignment="Bottom"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.ChartPoints, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="presentation:TrafficDailyChartPointViewModel">
                                    <Grid
                                        Width="17"
                                        Height="120"
                                        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                                        <StackPanel
                                            Margin="0,0,0,1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom">
                                            <Border
                                                Width="8"
                                                Height="{x:Bind UploadHeight, Mode=OneWay}"
                                                Background="{ThemeResource SystemFillColorCautionBrush}" />
                                            <Border
                                                Width="8"
                                                Height="{x:Bind DownloadHeight, Mode=OneWay}"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <ItemsControl
                        Width="510"
                        Height="28"
                        ItemsSource="{x:Bind ViewModel.ChartPoints, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="presentation:TrafficDailyChartPointViewModel">
                                <Grid
                                    Width="17"
                                    Height="28">
                                    <Border
                                        Width="1"
                                        Height="4"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource TextFillColorSecondaryBrush}"
                                        Visibility="{x:Bind AxisLabelVisibility, Mode=OneWay}" />
                                    <TextBlock
                                        Width="48"
                                        Margin="-16,6,-15,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind AxisLabel, Mode=OneWay}"
                                        TextAlignment="Center"
                                        Visibility="{x:Bind AxisLabelVisibility, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
