<UserControl
    x:Class="MihomoMeter.Windows.App.Presentation.FirstConnectionGuideView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel
            MaxWidth="620"
            Padding="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="24">
            <StackPanel Spacing="8">
                <TextBlock
                    FontSize="30"
                    FontWeight="SemiBold"
                    Text="第一次使用？从这里开始" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Mihomo Meter 不是代理客户端，也不提供节点或订阅。它只读取电脑上正在运行的 Mihomo；Clash Verge Rev 等常见客户端通常已经内置 Mihomo。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="28"
                        Height="28"
                        Background="{ThemeResource MihomoBrandPrimaryBrush}"
                        CornerRadius="14">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource MihomoOnAccentBrush}"
                            FontWeight="SemiBold"
                            Text="1" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock FontWeight="SemiBold" Text="准备 Mihomo" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="打开内置 Mihomo 的代理客户端；没有或不确定时先看教程。" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" Background="{ThemeResource MihomoBrandPrimaryBrush}" CornerRadius="14">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource MihomoOnAccentBrush}" FontWeight="SemiBold" Text="2" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock FontWeight="SemiBold" Text="开启外部控制器" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="在客户端中取得本机服务地址和访问密钥。" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" Background="{ThemeResource MihomoBrandPrimaryBrush}" CornerRadius="14">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource MihomoOnAccentBrush}" FontWeight="SemiBold" Text="3" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock FontWeight="SemiBold" Text="连接 Mihomo Meter" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="填写连接信息，验证成功后即可查看 Proxy 流量。" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="10">
                <HyperlinkButton
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Content="查看零基础教程"
                    NavigateUri="https://github.com/HongXunPan/mihomo-meter/wiki/%E5%87%86%E5%A4%87-Mihomo" />
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.HelpText="打开 Mihomo 连接设置窗口"
                    Click="OpenSettingsButton_Click"
                    Content="我已准备好，开始连接"
                    Style="{StaticResource AccentButtonStyle}" />
                <HyperlinkButton
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Content="还没有订阅配置？查看导入指引"
                    NavigateUri="https://github.com/HongXunPan/mihomo-meter/wiki/%E9%85%8D%E7%BD%AE%E8%AE%A2%E9%98%85%E5%9C%B0%E5%9D%80" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
