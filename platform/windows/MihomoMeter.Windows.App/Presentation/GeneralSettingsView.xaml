<UserControl
    x:Class="MihomoMeter.Windows.App.Presentation.GeneralSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="GeneralSettingsView_Loaded">

    <ScrollViewer>
        <StackPanel
            MaxWidth="720"
            Padding="32"
            HorizontalAlignment="Left"
            Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock
                    FontSize="32"
                    FontWeight="SemiBold"
                    Text="通用" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="管理当前用户的 Windows 登录启动行为。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <ToggleSwitch
                        x:Name="StartupToggle"
                        Header="登录后启动 Mihomo Meter"
                        Toggled="StartupToggle_Toggled" />
                    <TextBlock
                        x:Name="StartupStatusText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="RepairRegistrationButton"
                        HorizontalAlignment="Left"
                        Click="RepairRegistrationButton_Click"
                        Content="改为当前程序" />
                </StackPanel>
            </Border>

            <InfoBar
                x:Name="StartupErrorInfoBar"
                IsClosable="False"
                Severity="Error"
                Title="无法更新登录启动" />

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="登录启动固定使用当前用户权限，不会创建服务或计划任务。便携版移动到新目录后，需要从新位置重新开启。"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
