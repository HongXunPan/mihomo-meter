<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MihomoMeter.Windows.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TestingExtensionsProfile>None</TestingExtensionsProfile>
    <SharedCoreLibraryPath>$(MSBuildProjectDirectory)\..\..\..\.build\shared-core\x86_64-pc-windows-msvc\release\mihomo_meter_shared_core.dll</SharedCoreLibraryPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MihomoMeter.Windows.Core/MihomoMeter.Windows.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../Tests/Fixtures/*.json"
          Link="Fixtures/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../SharedCore/TestVectors/traffic_scale.json"
             Link="Fixtures/shared-core-traffic-scale.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(SharedCoreLibraryPath)"
             Link="mihomo_meter_shared_core.dll"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RequireSharedCoreLibrary" BeforeTargets="Build">
    <Error Condition="!Exists('$(SharedCoreLibraryPath)')"
           Text="缺少 Windows 共享核心 DLL，请先运行 scripts/build_shared_core_windows.ps1。" />
  </Target>
</Project>
